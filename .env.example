# Required: random string, at least 32 characters. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this install (used in emails and the install snippet).
APP_URL=http://localhost:3000

# Optional. Leave empty to use PGlite (embedded Postgres stored in ./.data). Use Postgres in production:
# DATABASE_URL=postgres://user:password@host:5432/customatic
DATABASE_URL=

# Optional: SMTP server for replies and team invitations. Without it, emails are logged instead of sent.
# SMTP_URL=smtps://user:password@smtp.resend.com:465
# EMAIL_FROM=Customatic <feedback@yourdomain.com>
SMTP_URL=
EMAIL_FROM=
