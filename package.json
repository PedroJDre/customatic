{
  "name": "customatic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run widget:build && npm run db:migrate && next dev",
    "build": "npm run widget:build && next build",
    "start": "npm run db:migrate && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "widget:build": "node scripts/build-widget.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:schema": "npx @better-auth/cli@latest generate --config scripts/auth-gen.ts --output src/db/auth-schema.ts --yes",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "vercel-build": "npm run widget:build && npm run db:migrate && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "modern-screenshot": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "description": "Open-source feedback widget and inbox for web apps.",
  "license": "MIT"
}
